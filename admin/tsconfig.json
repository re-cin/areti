{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["vite/client"]
  },
  "include": ["src", "../src/theme/colors.ts", "../src/features/pet/credit.ts", "../src/features/pet/levels.ts", "../src/features/pet/expressions.ts", "../src/features/pet/mood.ts", "../src/features/pet/focusLog.ts", "../src/features/pet/schedule.ts", "../src/features/pet/types.ts", "../src/features/pet/dialogue.ts", "../src/features/pet/slots.ts"]
}
